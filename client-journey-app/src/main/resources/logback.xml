<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="ROOT_LOG_LEVEL" value="${ROOT_LOG_LEVEL:-INFO}"/>
    <property name="APP_LOG_LEVEL" value="${APP_LOG_LEVEL:-INFO}"/>
    <property name="SECURITY_LOG_LEVEL" value="${SECURITY_LOG_LEVEL:-INFO}"/>
    <property name="AUDIT_LOG_LEVEL" value="${AUDIT_LOG_LEVEL:-INFO}"/>

    <property name="APP_MAX_FILE_SIZE" value="${APP_MAX_FILE_SIZE:-20MB}"/>
    <property name="APP_MAX_HISTORY_DAYS" value="${APP_MAX_HISTORY_DAYS:-30}"/>
    <property name="APP_TOTAL_SIZE_CAP" value="${APP_TOTAL_SIZE_CAP:-3GB}"/>

    <property name="SEC_MAX_FILE_SIZE" value="${SEC_MAX_FILE_SIZE:-10MB}"/>
    <property name="SEC_MAX_HISTORY_DAYS" value="${SEC_MAX_HISTORY_DAYS:-60}"/>
    <property name="SEC_TOTAL_SIZE_CAP" value="${SEC_TOTAL_SIZE_CAP:-2GB}"/>

    <property name="AUDIT_MAX_FILE_SIZE" value="${AUDIT_MAX_FILE_SIZE:-10MB}"/>
    <property name="AUDIT_MAX_HISTORY_DAYS" value="${AUDIT_MAX_HISTORY_DAYS:-90}"/>
    <property name="AUDIT_TOTAL_SIZE_CAP" value="${AUDIT_TOTAL_SIZE_CAP:-2GB}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${APP_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${APP_MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${APP_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/security.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${SEC_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${SEC_MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${SEC_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${AUDIT_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${AUDIT_MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${AUDIT_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="com.clientjourney" level="${APP_LOG_LEVEL}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </logger>

    <logger name="com.clientjourney.app.security" level="${SECURITY_LOG_LEVEL}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <logger name="com.clientjourney.app.admin" level="${AUDIT_LOG_LEVEL}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
