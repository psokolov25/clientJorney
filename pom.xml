<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.clientjourney</groupId>
  <artifactId>client-journey-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>client-journey-domain</module>
    <module>client-journey-core</module>
    <module>client-journey-storage-spi</module>
    <module>client-journey-storage-file</module>
    <module>client-journey-storage-h2</module>
    <module>client-journey-storage-postgres</module>
    <module>client-journey-channel-spi</module>
    <module>client-journey-channel-kafka</module>
    <module>client-journey-channel-telegram</module>
    <module>client-journey-channel-websocket</module>
    <module>client-journey-visit-visitmanager</module>
    <module>client-journey-visit-custom-rest</module>
    <module>client-journey-visit-mock</module>
    <module>client-journey-visit-spi</module>
    <module>client-journey-app</module>
  </modules>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <micronaut.version>4.4.7</micronaut.version>
  </properties>
  <profiles>
    <profile>
      <id>integration-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <executions>
              <execution>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                <configuration>
                  <includes><include>**/*IT.java</include></includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>test-resources</id>
      <properties>
        <clientjourney.test.resources.enabled>true</clientjourney.test.resources.enabled>
      </properties>
    </profile>
  </profiles>
</project>
